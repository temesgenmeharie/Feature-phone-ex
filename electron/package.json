{
  "name": "feature-phone-forensics-desktop",
  "version": "0.1.0",
  "description": "Offline Desktop Application for Feature Phone Digital Forensics",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "org.forensics.featurephone",
    "productName": "Feature Phone Forensics",
    "directories": {
      "output": "release"
    },
    "files": [
      "main.js",
      "preload.js",
      "../frontend/dist/**/*"
    ],
    "extraResources": [
      {
        "from": "../backend",
        "to": "backend",
        "filter": ["**/*", "!.venv/**", "!__pycache__/**", "!*.pyc"]
      }
    ],
    "win": {
      "target": "nsis"
    },
    "linux": {
      "target": "AppImage"
    }
  }
}
